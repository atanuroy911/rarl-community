# Copy to .env and fill in real values. .env is gitignored — never commit it.
# Any of these can also be injected as real environment variables instead (e.g. via
# cPanel's "Environment Variables" feature, where available).

# ── Database ───────────────────────────────────────────────
DB_HOST=localhost
DB_NAME=rarl_community
DB_USER=root
DB_PASS=

# ── Site ───────────────────────────────────────────────────
SITE_URL=https://rarl-lab.com/membership
MAIN_SITE_URL=https://rarl-lab.com

# ── Email ──────────────────────────────────────────────────
MAIL_FROM_NAME=RARL Community
MAIL_FROM_EMAIL=community@rarl-lab.com
MAIL_REPLY_TO=info@rarl-lab.com
ADMIN_EMAIL=admin@rarl-lab.com

# ── SMTP (optional but recommended in production) ───────────
# Leave SMTP_HOST blank to use PHP's mail() instead (fine for local dev, but
# more likely to land in spam). To send via a real cPanel mailbox instead:
# 1. cPanel → Email Accounts → create e.g. community@rarl-lab.com
# 2. SMTP_HOST is usually mail.yourdomain.com (check "Connect Devices" in
#    cPanel for the exact host cPanel gives that mailbox)
# 3. SMTP_USER is the full email address, SMTP_PASS is its mailbox password
# 4. Port 587 + SMTP_SECURE=tls (STARTTLS) is the usual default; some hosts
#    only offer port 465 + SMTP_SECURE=ssl (implicit TLS) — try 587 first
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=community@rarl-lab.com
SMTP_PASS=
SMTP_SECURE=tls

# ── Admin Auth ─────────────────────────────────────────────
# Generate a hash: php -r "echo password_hash('yourpassword', PASSWORD_BCRYPT);"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=REPLACE_WITH_YOUR_OWN_BCRYPT_HASH

# ── Membership ─────────────────────────────────────────────
REQUIRE_APPROVAL=1

# ── Misc ───────────────────────────────────────────────────
# Generate: php -r "echo bin2hex(random_bytes(32));"
SECRET_SALT=REPLACE_WITH_A_RANDOM_64_CHAR_STRING
APP_TIMEZONE=Asia/Kolkata
APP_DEBUG=0

# ── Deploy ─────────────────────────────────────────────────
# Protects deploy-extract.php (called by the GitHub Actions workflow after
# uploading deploy.zip). Generate the same way as SECRET_SALT and also add
# it as the DEPLOY_TOKEN secret in GitHub — the two must match.
DEPLOY_TOKEN=REPLACE_WITH_A_RANDOM_64_CHAR_STRING
